<?xml version="1.0" encoding="utf-8"?>
<edmx:Edmx Version="4.0" xmlns:edmx="http://docs.oasis-open.org/odata/ns/edmx">
  <edmx:Reference Uri="https://sap.github.io/odata-vocabularies/vocabularies/UI.xml">
    <edmx:Include Namespace="com.sap.vocabularies.UI.v1" Alias="UI"/>
  </edmx:Reference>
  <edmx:Reference Uri="https://sap.github.io/odata-vocabularies/vocabularies/Common.xml">
    <edmx:Include Namespace="com.sap.vocabularies.Common.v1" Alias="Common"/>
  </edmx:Reference>
  <edmx:DataServices>
    <Schema Namespace="dassian.tpm.annotations" xmlns="http://docs.oasis-open.org/odata/ns/edm">

      <Annotations Target="dassian.tpm.ControlAccount">

        <!-- Object-page / list header -->
        <Annotation Term="UI.HeaderInfo">
          <Record Type="UI.HeaderInfoType">
            <PropertyValue Property="TypeName" String="Control Account"/>
            <PropertyValue Property="TypeNamePlural" String="Control Accounts"/>
            <PropertyValue Property="Title">
              <Record Type="UI.DataField">
                <PropertyValue Property="Value" Path="Description"/>
              </Record>
            </PropertyValue>
            <PropertyValue Property="Description">
              <Record Type="UI.DataField">
                <PropertyValue Property="Value" Path="ID"/>
              </Record>
            </PropertyValue>
          </Record>
        </Annotation>

        <!-- Filter bar fields -->
        <Annotation Term="UI.SelectionFields">
          <Collection>
            <PropertyPath>ProgramID</PropertyPath>
            <PropertyPath>ProjectID</PropertyPath>
            <PropertyPath>Manager</PropertyPath>
          </Collection>
        </Annotation>

        <!-- KPI data points used in the table (coloured by criticality) -->
        <Annotation Term="UI.DataPoint" Qualifier="CPI">
          <Record Type="UI.DataPointType">
            <PropertyValue Property="Title" String="CPI"/>
            <PropertyValue Property="Value" Path="CPI"/>
            <PropertyValue Property="Criticality" Path="CPICriticality"/>
          </Record>
        </Annotation>
        <Annotation Term="UI.DataPoint" Qualifier="SPI">
          <Record Type="UI.DataPointType">
            <PropertyValue Property="Title" String="SPI"/>
            <PropertyValue Property="Value" Path="SPI"/>
            <PropertyValue Property="Criticality" Path="SPICriticality"/>
          </Record>
        </Annotation>
        <Annotation Term="UI.DataPoint" Qualifier="VAC">
          <Record Type="UI.DataPointType">
            <PropertyValue Property="Title" String="VAC"/>
            <PropertyValue Property="Value" Path="VAC"/>
            <PropertyValue Property="Criticality" Path="VACCriticality"/>
          </Record>
        </Annotation>

        <!-- Responsive table columns -->
        <Annotation Term="UI.LineItem">
          <Collection>
            <Record Type="UI.DataField">
              <PropertyValue Property="Value" Path="ID"/>
              <PropertyValue Property="Label" String="WBS / CA"/>
            </Record>
            <Record Type="UI.DataField">
              <PropertyValue Property="Value" Path="Description"/>
              <PropertyValue Property="Label" String="Description"/>
            </Record>
            <Record Type="UI.DataField">
              <PropertyValue Property="Value" Path="Manager"/>
              <PropertyValue Property="Label" String="CAM"/>
            </Record>
            <Record Type="UI.DataField">
              <PropertyValue Property="Value" Path="BAC"/>
              <PropertyValue Property="Label" String="BAC"/>
            </Record>
            <Record Type="UI.DataField">
              <PropertyValue Property="Value" Path="EAC"/>
              <PropertyValue Property="Label" String="EAC"/>
            </Record>
            <Record Type="UI.DataFieldForAnnotation">
              <PropertyValue Property="Target" AnnotationPath="@UI.DataPoint#VAC"/>
              <PropertyValue Property="Label" String="VAC"/>
            </Record>
            <Record Type="UI.DataFieldForAnnotation">
              <PropertyValue Property="Target" AnnotationPath="@UI.DataPoint#CPI"/>
              <PropertyValue Property="Label" String="CPI"/>
            </Record>
            <Record Type="UI.DataFieldForAnnotation">
              <PropertyValue Property="Target" AnnotationPath="@UI.DataPoint#SPI"/>
              <PropertyValue Property="Label" String="SPI"/>
            </Record>
          </Collection>
        </Annotation>

        <!-- Object-page field groups -->
        <Annotation Term="UI.FieldGroup" Qualifier="Identity">
          <Record Type="UI.FieldGroupType">
            <PropertyValue Property="Data">
              <Collection>
                <Record Type="UI.DataField"><PropertyValue Property="Value" Path="ID"/></Record>
                <Record Type="UI.DataField"><PropertyValue Property="Value" Path="Description"/></Record>
                <Record Type="UI.DataField"><PropertyValue Property="Value" Path="Manager"/></Record>
                <Record Type="UI.DataField"><PropertyValue Property="Value" Path="ProgramID"/></Record>
                <Record Type="UI.DataField"><PropertyValue Property="Value" Path="ProjectID"/></Record>
              </Collection>
            </PropertyValue>
          </Record>
        </Annotation>
        <Annotation Term="UI.FieldGroup" Qualifier="EVM">
          <Record Type="UI.FieldGroupType">
            <PropertyValue Property="Data">
              <Collection>
                <Record Type="UI.DataField"><PropertyValue Property="Value" Path="PlannedValue"/></Record>
                <Record Type="UI.DataField"><PropertyValue Property="Value" Path="EarnedValue"/></Record>
                <Record Type="UI.DataField"><PropertyValue Property="Value" Path="ActualCost"/></Record>
                <Record Type="UI.DataField"><PropertyValue Property="Value" Path="ScheduleVariance"/></Record>
                <Record Type="UI.DataField"><PropertyValue Property="Value" Path="CostVariance"/></Record>
                <Record Type="UI.DataField"><PropertyValue Property="Value" Path="BAC"/></Record>
                <Record Type="UI.DataField"><PropertyValue Property="Value" Path="EAC"/></Record>
                <Record Type="UI.DataFieldForAnnotation">
                  <PropertyValue Property="Target" AnnotationPath="@UI.DataPoint#VAC"/>
                </Record>
                <Record Type="UI.DataFieldForAnnotation">
                  <PropertyValue Property="Target" AnnotationPath="@UI.DataPoint#CPI"/>
                </Record>
                <Record Type="UI.DataFieldForAnnotation">
                  <PropertyValue Property="Target" AnnotationPath="@UI.DataPoint#SPI"/>
                </Record>
              </Collection>
            </PropertyValue>
          </Record>
        </Annotation>

        <!-- Object-page layout -->
        <Annotation Term="UI.Facets">
          <Collection>
            <Record Type="UI.ReferenceFacet">
              <PropertyValue Property="ID" String="IdentityFacet"/>
              <PropertyValue Property="Label" String="General Information"/>
              <PropertyValue Property="Target" AnnotationPath="@UI.FieldGroup#Identity"/>
            </Record>
            <Record Type="UI.ReferenceFacet">
              <PropertyValue Property="ID" String="EVMFacet"/>
              <PropertyValue Property="Label" String="Earned Value"/>
              <PropertyValue Property="Target" AnnotationPath="@UI.FieldGroup#EVM"/>
            </Record>
          </Collection>
        </Annotation>

      </Annotations>

      <!-- Value helps for filter fields -->
      <Annotations Target="dassian.tpm.ControlAccount/ProgramID">
        <Annotation Term="Common.Label" String="Program"/>
      </Annotations>
      <Annotations Target="dassian.tpm.ControlAccount/ProjectID">
        <Annotation Term="Common.Label" String="Project"/>
      </Annotations>
      <Annotations Target="dassian.tpm.ControlAccount/Manager">
        <Annotation Term="Common.Label" String="Control Account Manager"/>
      </Annotations>

      <!-- ============================ Project (Setup) ============================ -->
      <Annotations Target="dassian.tpm.Project">
        <Annotation Term="UI.HeaderInfo">
          <Record Type="UI.HeaderInfoType">
            <PropertyValue Property="TypeName" String="Project"/>
            <PropertyValue Property="TypeNamePlural" String="Projects"/>
            <PropertyValue Property="Title"><Record Type="UI.DataField"><PropertyValue Property="Value" Path="Name"/></Record></PropertyValue>
            <PropertyValue Property="Description"><Record Type="UI.DataField"><PropertyValue Property="Value" Path="ID"/></Record></PropertyValue>
          </Record>
        </Annotation>
        <Annotation Term="UI.SelectionFields">
          <Collection><PropertyPath>ProgramID</PropertyPath></Collection>
        </Annotation>
        <Annotation Term="UI.LineItem">
          <Collection>
            <Record Type="UI.DataField"><PropertyValue Property="Value" Path="ID"/><PropertyValue Property="Label" String="Project ID"/></Record>
            <Record Type="UI.DataField"><PropertyValue Property="Value" Path="Name"/><PropertyValue Property="Label" String="Name"/></Record>
            <Record Type="UI.DataField"><PropertyValue Property="Value" Path="ProgramID"/><PropertyValue Property="Label" String="Program"/></Record>
          </Collection>
        </Annotation>
        <Annotation Term="UI.FieldGroup" Qualifier="Header">
          <Record Type="UI.FieldGroupType"><PropertyValue Property="Data"><Collection>
            <Record Type="UI.DataField"><PropertyValue Property="Value" Path="ID"/></Record>
            <Record Type="UI.DataField"><PropertyValue Property="Value" Path="Name"/></Record>
            <Record Type="UI.DataField"><PropertyValue Property="Value" Path="ProgramID"/></Record>
          </Collection></PropertyValue></Record>
        </Annotation>
        <Annotation Term="UI.Facets">
          <Collection>
            <Record Type="UI.ReferenceFacet">
              <PropertyValue Property="ID" String="ProjectHeader"/>
              <PropertyValue Property="Label" String="Project Header"/>
              <PropertyValue Property="Target" AnnotationPath="@UI.FieldGroup#Header"/>
            </Record>
            <Record Type="UI.ReferenceFacet">
              <PropertyValue Property="ID" String="ProjectCAs"/>
              <PropertyValue Property="Label" String="Control Accounts"/>
              <PropertyValue Property="Target" AnnotationPath="ControlAccounts/@UI.LineItem"/>
            </Record>
          </Collection>
        </Annotation>
      </Annotations>
      <Annotations Target="dassian.tpm.Project/ProgramID"><Annotation Term="Common.Label" String="Program"/></Annotations>

      <!-- ============================ Risk ============================ -->
      <Annotations Target="dassian.tpm.Risk">

        <Annotation Term="UI.HeaderInfo">
          <Record Type="UI.HeaderInfoType">
            <PropertyValue Property="TypeName" String="Risk"/>
            <PropertyValue Property="TypeNamePlural" String="Risks"/>
            <PropertyValue Property="Title">
              <Record Type="UI.DataField"><PropertyValue Property="Value" Path="Description"/></Record>
            </PropertyValue>
            <PropertyValue Property="Description">
              <Record Type="UI.DataField"><PropertyValue Property="Value" Path="ID"/></Record>
            </PropertyValue>
          </Record>
        </Annotation>

        <Annotation Term="UI.SelectionFields">
          <Collection>
            <PropertyPath>Kind</PropertyPath>
            <PropertyPath>ProgramID</PropertyPath>
            <PropertyPath>ProjectID</PropertyPath>
            <PropertyPath>Category</PropertyPath>
            <PropertyPath>Status</PropertyPath>
          </Collection>
        </Annotation>

        <Annotation Term="UI.DataPoint" Qualifier="CurrentScore">
          <Record Type="UI.DataPointType">
            <PropertyValue Property="Title" String="Current Score"/>
            <PropertyValue Property="Value" Path="CurrentScore"/>
            <PropertyValue Property="Criticality" Path="ScoreCriticality"/>
          </Record>
        </Annotation>

        <Annotation Term="UI.LineItem">
          <Collection>
            <Record Type="UI.DataField"><PropertyValue Property="Value" Path="ID"/><PropertyValue Property="Label" String="Risk ID"/></Record>
            <Record Type="UI.DataField"><PropertyValue Property="Value" Path="Kind"/><PropertyValue Property="Label" String="Type"/></Record>
            <Record Type="UI.DataField"><PropertyValue Property="Value" Path="Title"/><PropertyValue Property="Label" String="Title"/></Record>
            <Record Type="UI.DataField"><PropertyValue Property="Value" Path="Category"/><PropertyValue Property="Label" String="Category (RBS)"/></Record>
            <Record Type="UI.DataField"><PropertyValue Property="Value" Path="ResponseStrategy"/><PropertyValue Property="Label" String="Response"/></Record>
            <Record Type="UI.DataField"><PropertyValue Property="Value" Path="Owner"/><PropertyValue Property="Label" String="Owner"/></Record>
            <Record Type="UI.DataField"><PropertyValue Property="Value" Path="Status"/><PropertyValue Property="Label" String="Status"/></Record>
            <Record Type="UI.DataFieldForAnnotation"><PropertyValue Property="Target" AnnotationPath="@UI.DataPoint#CurrentScore"/><PropertyValue Property="Label" String="Score"/></Record>
          </Collection>
        </Annotation>

        <Annotation Term="UI.FieldGroup" Qualifier="Identity">
          <Record Type="UI.FieldGroupType"><PropertyValue Property="Data"><Collection>
            <Record Type="UI.DataField"><PropertyValue Property="Value" Path="ID"/></Record>
            <Record Type="UI.DataField"><PropertyValue Property="Value" Path="Kind"/></Record>
            <Record Type="UI.DataField"><PropertyValue Property="Value" Path="Category"/></Record>
            <Record Type="UI.DataField"><PropertyValue Property="Value" Path="Owner"/></Record>
            <Record Type="UI.DataField"><PropertyValue Property="Value" Path="Status"/></Record>
            <Record Type="UI.DataField"><PropertyValue Property="Value" Path="WorkPackage"/></Record>
            <Record Type="UI.DataField"><PropertyValue Property="Value" Path="DateRaised"/></Record>
            <Record Type="UI.DataField"><PropertyValue Property="Value" Path="LastReviewed"/></Record>
          </Collection></PropertyValue></Record>
        </Annotation>
        <Annotation Term="UI.FieldGroup" Qualifier="Statement">
          <Record Type="UI.FieldGroupType"><PropertyValue Property="Data"><Collection>
            <Record Type="UI.DataField"><PropertyValue Property="Value" Path="Cause"/></Record>
            <Record Type="UI.DataField"><PropertyValue Property="Value" Path="Event"/></Record>
            <Record Type="UI.DataField"><PropertyValue Property="Value" Path="Effect"/></Record>
          </Collection></PropertyValue></Record>
        </Annotation>
        <Annotation Term="UI.FieldGroup" Qualifier="Assessment">
          <Record Type="UI.FieldGroupType"><PropertyValue Property="Data"><Collection>
            <Record Type="UI.DataField"><PropertyValue Property="Value" Path="Probability"/></Record>
            <Record Type="UI.DataField"><PropertyValue Property="Value" Path="Impact"/></Record>
            <Record Type="UI.DataField"><PropertyValue Property="Value" Path="OriginalScore"/></Record>
            <Record Type="UI.DataFieldForAnnotation"><PropertyValue Property="Target" AnnotationPath="@UI.DataPoint#CurrentScore"/></Record>
            <Record Type="UI.DataField"><PropertyValue Property="Value" Path="TargetScore"/></Record>
          </Collection></PropertyValue></Record>
        </Annotation>
        <Annotation Term="UI.FieldGroup" Qualifier="Response">
          <Record Type="UI.FieldGroupType"><PropertyValue Property="Data"><Collection>
            <Record Type="UI.DataField"><PropertyValue Property="Value" Path="ResponseStrategy"/></Record>
            <Record Type="UI.DataField"><PropertyValue Property="Value" Path="MitigationPlan"/></Record>
            <Record Type="UI.DataField"><PropertyValue Property="Value" Path="Triggers"/></Record>
            <Record Type="UI.DataField"><PropertyValue Property="Value" Path="TargetValue"/></Record>
          </Collection></PropertyValue></Record>
        </Annotation>

        <Annotation Term="UI.Facets">
          <Collection>
            <Record Type="UI.ReferenceFacet"><PropertyValue Property="ID" String="RiskIdentity"/><PropertyValue Property="Label" String="General Information"/><PropertyValue Property="Target" AnnotationPath="@UI.FieldGroup#Identity"/></Record>
            <Record Type="UI.ReferenceFacet"><PropertyValue Property="ID" String="RiskStatement"/><PropertyValue Property="Label" String="Risk Statement (Cause / Event / Effect)"/><PropertyValue Property="Target" AnnotationPath="@UI.FieldGroup#Statement"/></Record>
            <Record Type="UI.ReferenceFacet"><PropertyValue Property="ID" String="RiskAssessment"/><PropertyValue Property="Label" String="Assessment"/><PropertyValue Property="Target" AnnotationPath="@UI.FieldGroup#Assessment"/></Record>
            <Record Type="UI.ReferenceFacet"><PropertyValue Property="ID" String="RiskResponse"/><PropertyValue Property="Label" String="Response"/><PropertyValue Property="Target" AnnotationPath="@UI.FieldGroup#Response"/></Record>
          </Collection>
        </Annotation>

      </Annotations>

      <Annotations Target="dassian.tpm.Risk/Kind"><Annotation Term="Common.Label" String="Type"/></Annotations>
      <Annotations Target="dassian.tpm.Risk/ProgramID"><Annotation Term="Common.Label" String="Program"/></Annotations>
      <Annotations Target="dassian.tpm.Risk/ProjectID"><Annotation Term="Common.Label" String="Project"/></Annotations>
      <Annotations Target="dassian.tpm.Risk/Category"><Annotation Term="Common.Label" String="Category (RBS)"/></Annotations>
      <Annotations Target="dassian.tpm.Risk/ResponseStrategy"><Annotation Term="Common.Label" String="Response Strategy"/></Annotations>

    </Schema>
  </edmx:DataServices>
</edmx:Edmx>
