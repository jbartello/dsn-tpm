<mvc:View
  controllerName="dassian.tpm.ui5.controller.VAR"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  displayBlock="true">
  <Page id="varPage" title="Variance Analysis Report — Format 5"
        class="sapUiResponsiveContentPadding">
    <subHeader>
      <OverflowToolbar>
        <Label text="Program"/>
        <Select selectedKey="{ui>/program}" change=".onProgramChange">
          <core:Item key="DEMO" text="Demo"/>
          <core:Item key="MFG" text="MFG Program"/>
        </Select>
        <ToolbarSeparator/>
        <Label text="Project"/>
        <Select selectedKey="{flt>/project}" items="{flt>/projects}" change=".onFilterChange" autoAdjustWidth="true">
          <core:Item key="{flt>key}" text="{flt>text}"/>
        </Select>
        <Label text="CAM"/>
        <Select selectedKey="{flt>/cam}" items="{flt>/cams}" change=".onFilterChange" autoAdjustWidth="true">
          <core:Item key="{flt>key}" text="{flt>text}"/>
        </Select>
        <Label text="Month End"/>
        <Select selectedKey="{flt>/period}" items="{flt>/periods}" change=".onFilterChange" autoAdjustWidth="true">
          <core:Item key="{flt>key}" text="{flt>text}"/>
        </Select>
      </OverflowToolbar>
    </subHeader>
    <content>
      <VBox class="sapUiMediumMargin">
        <HBox wrap="Wrap" class="sapUiSmallMarginBottom">
          <VBox class="mcStatBox"><Text text="Cost Performance (CPI)" class="mcStatLbl"/><ObjectStatus text="{narr>/sum/cpiT}" state="{narr>/sum/cpiState}" class="pvKpiVal"/><Text text="{narr>/sum/cpiSub}" class="mcStatLbl"/></VBox>
          <VBox class="mcStatBox"><Text text="Schedule Performance (SPI)" class="mcStatLbl"/><ObjectStatus text="{narr>/sum/spiT}" state="{narr>/sum/spiState}" class="pvKpiVal"/><Text text="{narr>/sum/spiSub}" class="mcStatLbl"/></VBox>
          <VBox class="mcStatBox"><Text text="Cost Variance" class="mcStatLbl"/><ObjectStatus text="{narr>/sum/cvT}" state="{narr>/sum/cvState}" class="pvKpiVal"/><Text text="Program rollup" class="mcStatLbl"/></VBox>
          <VBox class="mcStatBox"><Text text="Schedule Variance" class="mcStatLbl"/><ObjectStatus text="{narr>/sum/svT}" state="{narr>/sum/svState}" class="pvKpiVal"/><Text text="Program rollup" class="mcStatLbl"/></VBox>
          <VBox class="mcStatBox"><Text text="Variance Alerts" class="mcStatLbl"/><ObjectStatus text="{narr>/sum/alerts}" state="{narr>/sum/alertState}" class="pvKpiVal"/><Text text="{narr>/sum/alertSub}" class="mcStatLbl"/></VBox>
        </HBox>

        <Title text="Variance Narrative — out-of-tolerance WBS" level="H2"/>
        <Text text="Click a control account to expand its CPR/IPMR Format 5 narrative: earned-value figures, root cause, impact, corrective action and get-well date, with an AI-draft helper and an approve workflow." class="sapUiSmallMarginBottom sapUiSmallMarginTop"/>

        <VBox items="{narr>/items}">
          <Panel expandable="true" expanded="false" class="sapUiSmallMarginBottom" width="auto">
            <headerToolbar>
              <OverflowToolbar>
                <ObjectIdentifier title="{narr>wbs}" text="{narr>desc} · CAM {narr>cam}"/>
                <ToolbarSpacer/>
                <ObjectStatus text="CPI {narr>cpiT}" state="{= ${narr>cpi} &lt; 0.95 ? 'Error' : 'Success' }" class="sapUiTinyMarginEnd"/>
                <ObjectStatus text="SPI {narr>spiT}" state="{= ${narr>spi} &lt; 0.95 ? 'Error' : 'Success' }" class="sapUiTinyMarginEnd"/>
                <ObjectStatus
                  text="{= ${narr>rc} &amp;&amp; ${narr>im} &amp;&amp; ${narr>ca} ? 'Narrative complete' : 'Narrative pending' }"
                  state="{= ${narr>rc} &amp;&amp; ${narr>im} &amp;&amp; ${narr>ca} ? 'Success' : 'Warning' }"
                  icon="{= ${narr>rc} &amp;&amp; ${narr>im} &amp;&amp; ${narr>ca} ? 'sap-icon://sys-enter-2' : 'sap-icon://pending' }"/>
              </OverflowToolbar>
            </headerToolbar>
            <content>
              <VBox class="sapUiSmallMargin">
                <Text text="{narr>narr}" class="sapUiSmallMarginBottom"/>
                <HBox justifyContent="SpaceBetween" alignItems="Center" wrap="Wrap" class="sapUiSmallMarginBottom">
                  <Text text="{= '▶ Recommend a corrective-action review with the control account manager (' + ${narr>cam} + ').' }"/>
                  <Button text="{= ${narr>notified} ? 'Workflow created' : 'Notify CAM' }" icon="{= ${narr>notified} ? 'sap-icon://accept' : 'sap-icon://email' }"
                          press=".onNotifyCAM" enabled="{= !${narr>notified} }"/>
                </HBox>
                <HBox wrap="Wrap">
                  <VBox class="mcStatBox"><Text text="BCWS" class="mcStatLbl"/><Title text="{narr>bcwsT}" level="H4"/></VBox>
                  <VBox class="mcStatBox"><Text text="BCWP" class="mcStatLbl"/><Title text="{narr>bcwpT}" level="H4"/></VBox>
                  <VBox class="mcStatBox"><Text text="ACWP" class="mcStatLbl"/><Title text="{narr>acwpT}" level="H4"/></VBox>
                  <VBox class="mcStatBox"><Text text="CV" class="mcStatLbl"/><Title text="{narr>cvT}" level="H4"/></VBox>
                  <VBox class="mcStatBox"><Text text="SV" class="mcStatLbl"/><Title text="{narr>svT}" level="H4"/></VBox>
                  <VBox class="mcStatBox"><Text text="VAC" class="mcStatLbl"/><Title text="{narr>vacT}" level="H4"/></VBox>
                </HBox>

                <MessageStrip
                  class="sapUiSmallMarginTop"
                  visible="{narr>aiDrafted}"
                  type="Information" showIcon="true"
                  text="AI-drafted — unverified. The model describes what the data shows; it cannot know the cause. Confirm root cause with the CAM before approving."/>

                <HBox wrap="Wrap" class="sapUiSmallMarginTop">
                  <Button text="AI draft narrative" icon="sap-icon://discussion-2" press=".onAiDraft" width="12rem"/>
                  <Button text="Import previous period" icon="sap-icon://past" press=".onImportPrev" width="14rem" class="sapUiTinyMarginBegin"/>
                </HBox>

                <Label text="Root cause" class="sapUiSmallMarginTop"/>
                <TextArea value="{narr>rc}" rows="3" width="100%" growing="true"/>
                <Label text="Cost / schedule impact" class="sapUiSmallMarginTop"/>
                <TextArea value="{narr>im}" rows="2" width="100%" growing="true"/>
                <Label text="Corrective action plan" class="sapUiSmallMarginTop"/>
                <TextArea value="{narr>ca}" rows="3" width="100%" growing="true"/>
                <Label text="Get-well date" class="sapUiSmallMarginTop"/>
                <Input value="{narr>gw}" placeholder="YYYY-MM" width="10rem"/>

                <HBox justifyContent="SpaceBetween" alignItems="Center" class="sapUiMediumMarginTop" wrap="Wrap">
                  <Text text="{= 'Workflow: ' + (${narr>approved} ? 'Approved' : 'Auto-opened') + ' → In analysis → Review → Approved' }"/>
                  <Button text="Approve VAR" type="Emphasized" icon="sap-icon://accept" press=".onApprove" enabled="{= !${narr>approved} }"/>
                </HBox>
              </VBox>
            </content>
          </Panel>
        </VBox>

        <Table items="{narr>/all}" class="sapUiMediumMarginTop">
          <headerToolbar><OverflowToolbar><Title text="Control Account Variance"/></OverflowToolbar></headerToolbar>
          <columns>
            <Column><Text text="WBS"/></Column>
            <Column><Text text="Description"/></Column>
            <Column><Text text="CAM"/></Column>
            <Column hAlign="End"><Text text="CV %"/></Column>
            <Column hAlign="End"><Text text="SV %"/></Column>
            <Column hAlign="End"><Text text="CPI"/></Column>
            <Column hAlign="End"><Text text="SPI"/></Column>
            <Column><Text text="Trend"/></Column>
            <Column><Text text="Status"/></Column>
          </columns>
          <items>
            <ColumnListItem>
              <cells>
                <Text text="{narr>wbs}"/>
                <Text text="{narr>desc}"/>
                <Text text="{narr>cam}"/>
                <ObjectNumber number="{narr>cvpT}" state="{narr>cvState}"/>
                <ObjectNumber number="{narr>svpT}" state="{narr>svState}"/>
                <Text text="{narr>cpiT}"/>
                <Text text="{narr>spiT}"/>
                <ObjectStatus text="{narr>trend}" state="{narr>trendState}"/>
                <ObjectStatus text="{narr>status}" state="{narr>statusState}"/>
              </cells>
            </ColumnListItem>
          </items>
        </Table>
      </VBox>
    </content>
  </Page>
</mvc:View>
