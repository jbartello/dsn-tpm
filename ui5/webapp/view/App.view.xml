<mvc:View
  controllerName="dassian.tpm.ui5.controller.App"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:tnt="sap.tnt"
  xmlns:core="sap.ui.core"
  displayBlock="true"
  height="100%">
  <tnt:ToolPage id="toolPage">
    <tnt:header>
      <tnt:ToolHeader>
        <Button icon="sap-icon://menu2" type="Transparent" tooltip="Toggle navigation" press=".onToggleNav"/>
        <tnt:ToolHeaderUtilitySeparator/>
        <Title text="Dassian Total Program Management" level="H2" wrapping="false" class="sapUiSmallMarginBegin"/>
        <ToolbarSpacer/>
        <Text text="SAP" class="sapUiSmallMarginEnd"/>
      </tnt:ToolHeader>
    </tnt:header>
    <tnt:sideContent>
      <tnt:SideNavigation id="sideNav" expanded="true" itemSelect=".onNavSelect">
        <tnt:NavigationList>
          <tnt:NavigationListItem text="Overview" icon="sap-icon://home" key="Home"/>
          <tnt:NavigationListItem text="Program Information" icon="sap-icon://official-service" key="ProgramInfo"/>
          <tnt:NavigationListItem text="Project Setup" icon="sap-icon://action-settings" key="ProjectSetup"/>
          <tnt:NavigationListItem text="Project Values" icon="sap-icon://table-view" key="ProjectValues"/>
          <tnt:NavigationListItem text="Project Analytics" icon="sap-icon://line-chart" key="Analytics"/>
          <tnt:NavigationListItem text="Risk Information" icon="sap-icon://alert" key="RiskInfo"/>
          <tnt:NavigationListItem text="Master Schedule" icon="sap-icon://gantt-bars" key="MasterSchedule"/>
          <tnt:NavigationListItem text="Variance Analysis" icon="sap-icon://status-critical" key="VAR"/>
          <tnt:NavigationListItem text="Project EAC" icon="sap-icon://money-bills" key="EAC"/>
          <tnt:NavigationListItem text="Baseline Change" icon="sap-icon://request" key="BaselineChangesList"/>
          <tnt:NavigationListItem text="Artifacts &amp; Reports" icon="sap-icon://documents" key="Artifacts"/>
        </tnt:NavigationList>
      </tnt:SideNavigation>
    </tnt:sideContent>
    <tnt:mainContents>
      <NavContainer id="appContent"/>
    </tnt:mainContents>
  </tnt:ToolPage>
</mvc:View>
