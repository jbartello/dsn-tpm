<mvc:View
  controllerName="dassian.tpm.ui5.controller.RiskInfo"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  displayBlock="true">
  <Page id="riskInfoPage" title="Risk Information" showNavButton="true" navButtonPress=".onNavBack"
        class="sapUiResponsiveContentPadding">
    <subHeader>
      <OverflowToolbar>
        <Label text="Program"/>
        <Select selectedKey="{ui>/program}" change=".onProgramChange">
          <core:Item key="DEMO" text="Demo"/>
          <core:Item key="MFG" text="MFG Program"/>
        </Select>
        <ToolbarSpacer/>
        <SegmentedButton selectedKey="{risk>/kind}" selectionChange=".onKindChange">
          <items>
            <SegmentedButtonItem key="Risk" text="Risks ({risk>/riskCount})"/>
            <SegmentedButtonItem key="Opportunity" text="Opportunities ({risk>/oppCount})"/>
          </items>
        </SegmentedButton>
      </OverflowToolbar>
    </subHeader>
    <content>
      <VBox class="sapUiMediumMargin">
        <Title text="Probability × Impact" level="H3" class="sapUiTinyMarginBottom"/>
        <core:HTML id="matrixHtml" class="sapUiSmallMarginBottom"/>

        <Table id="riskTable" items="{risk>/items}" growing="true" growingThreshold="20" class="sapUiMediumMarginTop">
          <headerToolbar>
            <OverflowToolbar>
              <Title text="{= ${risk>/kind} === 'Risk' ? 'Risks' : 'Opportunities' } Register"/>
              <ToolbarSpacer/>
              <Button text="{= ${risk>/kind} === 'Risk' ? 'Create New Risk' : 'Create New Opportunity' }"
                      type="Emphasized" icon="sap-icon://add" press=".onCreateRisk"/>
            </OverflowToolbar>
          </headerToolbar>
          <columns>
            <Column><Text text="ID"/></Column>
            <Column><Text text="Title"/></Column>
            <Column><Text text="Category (RBS)"/></Column>
            <Column><Text text="Response"/></Column>
            <Column><Text text="Owner"/></Column>
            <Column><Text text="Status"/></Column>
            <Column hAlign="End"><Text text="Current Score"/></Column>
          </columns>
          <items>
            <ColumnListItem type="Navigation" press=".onRiskPress">
              <cells>
                <Text text="{risk>ID}"/>
                <Text text="{risk>Title}"/>
                <Text text="{risk>Category}"/>
                <Text text="{risk>ResponseStrategy}"/>
                <Text text="{risk>Owner}"/>
                <Text text="{risk>Status}"/>
                <Text text="{risk>CurrentScore}" class="scoreCell"/>
              </cells>
            </ColumnListItem>
          </items>
        </Table>
      </VBox>

      <Dialog id="riskDialog" contentWidth="44rem" stretch="{device>/system/phone}"
              title="{= ${sel>/isNew} ? ('New ' + (${sel>/Kind} === 'Opportunity' ? 'Opportunity' : 'Risk')) : (${sel>/ID} + ' — ' + ${sel>/Description}) }">
        <content>
          <IconTabBar expandable="false">
            <items>
              <IconTabFilter text="Risk Details" key="det">
                <VBox class="sapUiSmallMargin">
                  <Label text="Risk ID"/><Input value="{sel>/ID}" editable="false"/>
                  <Label text="Project ID" class="sapUiTinyMarginTop"/><Input value="{sel>/ProjectID}" editable="false"/>
                  <Label text="Short Description" class="sapUiTinyMarginTop"/><Input value="{sel>/Title}" editable="{sel>/edit}"/>
                  <Label text="Description" class="sapUiTinyMarginTop"/><TextArea value="{sel>/Description}" editable="{sel>/edit}" rows="2" width="100%" growing="true"/>
                  <Label text="Category (RBS)" class="sapUiTinyMarginTop"/><Input value="{sel>/Category}" editable="{sel>/edit}"/>
                  <Label text="Work Package" class="sapUiTinyMarginTop"/><Input value="{sel>/WorkPackage}" editable="{sel>/edit}"/>
                  <Label text="Type" class="sapUiTinyMarginTop"/>
                  <Select selectedKey="{sel>/Kind}" enabled="{sel>/edit}" width="14rem">
                    <core:Item key="Risk" text="Risk"/><core:Item key="Opportunity" text="Opportunity"/>
                  </Select>
                  <Label text="Owner" class="sapUiTinyMarginTop"/><Input value="{sel>/Owner}" editable="{sel>/edit}"/>
                  <Label text="Status" class="sapUiTinyMarginTop"/>
                  <Select selectedKey="{sel>/Status}" enabled="{sel>/edit}" items="{cfg>/statuses}" width="14rem"><core:Item key="{cfg>}" text="{cfg>}"/></Select>
                  <Label text="Date Raised" class="sapUiTinyMarginTop"/><Input value="{sel>/DateRaised}" editable="false" width="14rem"/>
                  <Label text="Cause" class="sapUiTinyMarginTop"/><TextArea value="{sel>/Cause}" editable="{sel>/edit}" rows="2" width="100%" growing="true"/>
                  <Label text="Event" class="sapUiTinyMarginTop"/><TextArea value="{sel>/Event}" editable="{sel>/edit}" rows="2" width="100%" growing="true"/>
                  <Label text="Effect" class="sapUiTinyMarginTop"/><TextArea value="{sel>/Effect}" editable="{sel>/edit}" rows="2" width="100%" growing="true"/>

                  <Title text="Risk Values (USD)" level="H5" class="sapUiMediumMarginTop sapUiTinyMarginBottom"/>
                  <Label text="Risk Value"/><Input value="{sel>/RiskValue}" editable="{sel>/edit}" type="Number" width="14rem"/>
                  <Label text="Original Value" class="sapUiTinyMarginTop"/><Input value="{sel>/OriginalValue}" editable="false" width="14rem"/>
                  <Label text="Current Mitigated Value" class="sapUiTinyMarginTop"/><Input value="{sel>/CurrentValue}" editable="false" width="14rem"/>
                  <Label text="Target Value" class="sapUiTinyMarginTop"/><Input value="{sel>/TargetValue}" editable="false" width="14rem"/>
                </VBox>
              </IconTabFilter>

              <IconTabFilter text="Scoring" key="sco">
                <VBox class="sapUiSmallMargin">
                  <Label text="Probability"/>
                  <Select selectedKey="{sel>/Probability}" enabled="{sel>/edit}" items="{cfg>/prob}" change=".onScoreChange" width="16rem"><core:Item key="{cfg>}" text="{cfg>}"/></Select>
                  <Label text="Impact" class="sapUiTinyMarginTop"/>
                  <Select selectedKey="{sel>/Impact}" enabled="{sel>/edit}" items="{cfg>/impact}" change=".onScoreChange" width="16rem"><core:Item key="{cfg>}" text="{cfg>}"/></Select>
                  <Label text="Original Score" class="sapUiTinyMarginTop"/><Input value="{sel>/OriginalScore}" editable="false" width="10rem"/>
                  <Label text="Current Score" class="sapUiTinyMarginTop"/><Input value="{sel>/CurrentScore}" editable="false" width="10rem"/>
                  <Label text="Target Score" class="sapUiTinyMarginTop"/><Input value="{sel>/TargetScore}" editable="false" width="10rem"/>
                  <Text text="Scores are computed from Probability × Impact; Target Score is driven by the mitigation tasks." class="sapUiTinyMarginTop"/>
                </VBox>
              </IconTabFilter>

              <IconTabFilter text="Mitigation" key="mit">
                <VBox class="sapUiSmallMargin">
                  <Label text="Response Strategy"/>
                  <Select selectedKey="{sel>/ResponseStrategy}" enabled="{sel>/edit}" items="{cfg>/strategies}" width="16rem"><core:Item key="{cfg>}" text="{cfg>}"/></Select>
                  <Label text="Mitigation Plan" class="sapUiTinyMarginTop"/><TextArea value="{sel>/MitigationPlan}" editable="{sel>/edit}" rows="3" width="100%" growing="true"/>
                  <Label text="Triggers / Warning Signs" class="sapUiTinyMarginTop"/><TextArea value="{sel>/Triggers}" editable="{sel>/edit}" rows="2" width="100%" growing="true"/>
                  <Label text="Last Reviewed Date" class="sapUiTinyMarginTop"/><Input value="{sel>/LastReviewed}" editable="false" width="14rem"/>
                </VBox>
              </IconTabFilter>

              <IconTabFilter text="Tasks" key="tsk">
                <VBox class="sapUiSmallMargin">
                  <Table items="{sel>/tasks}" noDataText="No mitigation tasks.">
                    <headerToolbar>
                      <OverflowToolbar>
                        <Title text="Mitigation Tasks"/>
                        <ToolbarSpacer/>
                        <Button text="Add Task" icon="sap-icon://add" visible="{sel>/edit}" press=".onAddTask"/>
                      </OverflowToolbar>
                    </headerToolbar>
                    <columns>
                      <Column><Text text="Description"/></Column>
                      <Column><Text text="Start"/></Column>
                      <Column><Text text="End"/></Column>
                      <Column><Text text="Assigned To"/></Column>
                      <Column hAlign="End"><Text text="Target Score"/></Column>
                      <Column><Text text="Status"/></Column>
                      <Column hAlign="End"><Text text="Target Value"/></Column>
                      <Column width="3rem"><Text text=""/></Column>
                    </columns>
                    <items>
                      <ColumnListItem>
                        <cells>
                          <Input value="{sel>Desc}" editable="{sel>/edit}"/>
                          <Input value="{sel>Start}" editable="{sel>/edit}"/>
                          <Input value="{sel>End}" editable="{sel>/edit}"/>
                          <Input value="{sel>Assigned}" editable="{sel>/edit}"/>
                          <Input value="{sel>TargetScore}" editable="{sel>/edit}" change=".onTaskScoreChange"/>
                          <Input value="{sel>Status}" editable="{sel>/edit}"/>
                          <Input value="{sel>TargetValue}" editable="{sel>/edit}"/>
                          <Button icon="sap-icon://delete" type="Transparent" visible="{sel>/edit}" press=".onDeleteTask"/>
                        </cells>
                      </ColumnListItem>
                    </items>
                  </Table>
                </VBox>
              </IconTabFilter>

              <IconTabFilter text="Waterfall" key="wat">
                <core:HTML id="waterfallHtml" class="sapUiSmallMargin"/>
              </IconTabFilter>
            </items>
          </IconTabBar>
        </content>
        <buttons>
          <Button text="Edit" icon="sap-icon://edit" visible="{= !${sel>/edit} }" press=".onEditRisk"/>
          <Button text="Save" type="Emphasized" icon="sap-icon://save" visible="{sel>/edit}" press=".onSaveRisk"/>
          <Button text="Close" press=".onCloseDialog"/>
        </buttons>
      </Dialog>
    </content>
  </Page>
</mvc:View>
