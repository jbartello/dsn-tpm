<mvc:View
  controllerName="dassian.tpm.ui5.controller.Home"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:f="sap.f"
  displayBlock="true">
  <Page id="homePage" title="Dassian Total Program Management" showHeader="true" class="sapUiResponsiveContentPadding">
    <content>
      <VBox class="sapUiMediumMargin">
        <Title text="Program Workspace" level="H2" class="sapUiSmallMarginBottom"/>
        <f:GridContainer snapToRow="true">
          <f:layout>
            <f:GridContainerSettings rowSize="7rem" columnSize="7rem" gap="0.75rem"/>
          </f:layout>
          <GenericTile header="Program Information" subheader="Contract header &amp; rolled-up EVM" press=".onOpenProgramInfo">
            <TileContent>
              <NumericContent value="Program" valueColor="Neutral" icon="sap-icon://official-service"/>
            </TileContent>
          </GenericTile>
          <GenericTile header="Project Values" subheader="Control Account Summary · EVM" press=".onOpenControlAccounts">
            <TileContent unit="accounts">
              <NumericContent value="39" valueColor="Neutral" icon="sap-icon://table-view"/>
            </TileContent>
          </GenericTile>
          <GenericTile header="Risk Information" subheader="Register &amp; 5×5 matrix" press=".onOpenRiskInfo">
            <TileContent unit="items">
              <NumericContent value="13" valueColor="Critical" icon="sap-icon://alert"/>
            </TileContent>
          </GenericTile>
          <GenericTile header="Project Analytics" subheader="EVM charts" press=".onOpenAnalytics">
            <TileContent>
              <NumericContent value="EVM" valueColor="Good" icon="sap-icon://bar-chart"/>
            </TileContent>
          </GenericTile>
          <GenericTile header="Master Schedule" subheader="Monte Carlo schedule risk" press=".onOpenMasterSchedule">
            <TileContent unit="activities">
              <NumericContent value="65" valueColor="Neutral" icon="sap-icon://gantt-bars"/>
            </TileContent>
          </GenericTile>
          <GenericTile header="Variance Analysis" subheader="Format 5 VAR narratives" press=".onOpenVAR">
            <TileContent>
              <NumericContent value="VAR" valueColor="Critical" icon="sap-icon://notes"/>
            </TileContent>
          </GenericTile>
          <GenericTile header="Project Setup" subheader="Projects &amp; control accounts" press=".onOpenSetup">
            <TileContent unit="projects">
              <NumericContent value="4" valueColor="Neutral" icon="sap-icon://settings"/>
            </TileContent>
          </GenericTile>
          <GenericTile header="Project EAC" subheader="Estimate at completion" press=".onOpenEac">
            <TileContent>
              <NumericContent value="EAC" valueColor="Neutral" icon="sap-icon://money-bills"/>
            </TileContent>
          </GenericTile>
          <GenericTile header="Baseline Change" subheader="Change request log" press=".onOpenBcr">
            <TileContent unit="requests">
              <NumericContent value="9" valueColor="Neutral" icon="sap-icon://request"/>
            </TileContent>
          </GenericTile>
          <GenericTile header="Artifacts &amp; Reports" subheader="Program document catalog" press=".onOpenArtifacts">
            <TileContent unit="artifacts">
              <NumericContent value="10" valueColor="Neutral" icon="sap-icon://documents"/>
            </TileContent>
          </GenericTile>
        </f:GridContainer>
      </VBox>
    </content>
  </Page>
</mvc:View>
