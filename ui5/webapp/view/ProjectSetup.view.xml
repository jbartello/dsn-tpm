<mvc:View
  controllerName="dassian.tpm.ui5.controller.ProjectSetup"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  xmlns:f="sap.ui.layout.form"
  displayBlock="true">
  <Page id="setupPage" title="Project Setup"
        class="sapUiResponsiveContentPadding">
    <subHeader>
      <OverflowToolbar>
        <Label text="Program"/>
        <Select selectedKey="{ui>/program}" change=".onProgramChange">
          <core:Item key="DEMO" text="Demo"/>
          <core:Item key="MFG" text="MFG Program"/>
        </Select>
      </OverflowToolbar>
    </subHeader>
    <content>
      <VBox class="sapUiMediumMargin">

        <Panel headerText="Project Header" class="sapUiSmallMarginBottom" expandable="true" expanded="false">
          <f:SimpleForm layout="ResponsiveGridLayout" editable="true"
                        labelSpanXL="5" labelSpanL="5" labelSpanM="5" columnsXL="2" columnsL="2" columnsM="2">
            <Label text="Reporting Level"/>
            <Select selectedKey="{set>/header/reporting}" items="{set>/opts/reporting}"><core:Item key="{set>}" text="{set>}"/></Select>
            <Label text="Program Manager"/>
            <Input value="{set>/header/pm}"/>
            <Label text="PMB Version"/>
            <Select selectedKey="{set>/header/pmbVer}" items="{set>/opts/pmbVer}"><core:Item key="{set>}" text="{set>}"/></Select>
            <Label text="EAC Version"/>
            <Select selectedKey="{set>/header/eacVer}" items="{set>/opts/eacVer}"><core:Item key="{set>}" text="{set>}"/></Select>
            <Label text="Extract Profile"/>
            <Select selectedKey="{set>/header/extract}" items="{set>/opts/extract}"><core:Item key="{set>}" text="{set>}"/></Select>
            <Label text="OBS"/>
            <Input value="{set>/header/obs}"/>
          </f:SimpleForm>
        </Panel>

        <Panel headerText="Variance Thresholds — /DSN/PPCN" class="sapUiSmallMarginBottom" expandable="true" expanded="false">
          <headerToolbar>
            <OverflowToolbar>
              <Title text="Variance Thresholds — /DSN/PPCN"/>
              <ToolbarSpacer/>
              <Button text="Copy thresholds from another project" icon="sap-icon://copy" press=".onCopyThresholds"/>
            </OverflowToolbar>
          </headerToolbar>
          <VBox>
            <Text text="Period thresholds apply to the current accounting period; cumulative thresholds apply to project-to-date. Upper/Lower limits bound positive/negative variance; % drives each object's Red/Yellow/Green status (CPR Format 5). Variance at Complete is cumulative only. Blank = 0." class="sapUiTinyMarginBottom"/>
            <core:HTML id="threshHtml"/>
          </VBox>
        </Panel>

        <Panel headerText="WBS Structure &amp; Classification (EIA-748)" expandable="true" expanded="true">
          <VBox>
            <Text text="Select a WBS element, then classify it as a Control Account, Work Package, or Management Reserve / Undistributed Budget and maintain its attributes. The structure rules are enforced: a work package must sit below a control account; control accounts cannot nest; MR/UB cannot sit inside a control account (no control account above it), but may be held at a summary level above control accounts." class="sapUiSmallMarginBottom"/>
            <SegmentedButton selectedKey="{ps>/mode}" selectionChange=".onModeChange" class="sapUiSmallMarginBottom">
              <items>
                <SegmentedButtonItem key="ca" text="Control Accounts"/>
                <SegmentedButtonItem key="wp" text="Work Packages"/>
                <SegmentedButtonItem key="mrub" text="MR / UB"/>
              </items>
            </SegmentedButton>

            <HBox wrap="Wrap" alignItems="Start">
              <!-- WBS tree -->
              <VBox class="ps-tree sapUiSmallMarginEnd">
                <Tree id="wbsTree" items="{path: 'ps>/tree', parameters: {arrayNames: ['children']}}"
                      mode="SingleSelectMaster" selectionChange=".onNodeSelect" width="100%">
                  <CustomTreeItem>
                    <HBox alignItems="Center" class="sapUiTinyMarginBeginEnd">
                      <Text text="{ps>title}" wrapping="false"/>
                      <HBox items="{ps>badges}">
                        <ObjectStatus text="{ps>text}" state="{ps>state}" inverted="true" class="sapUiTinyMarginBegin"/>
                      </HBox>
                    </HBox>
                  </CustomTreeItem>
                </Tree>
              </VBox>

              <!-- Detail / classification panel -->
              <VBox class="ps-detail">
                <Title text="{= ${ps>/d/hasSel} ? ${ps>/selNode/id} + ' · ' + ${ps>/selNode/desc} : 'Select a WBS element' }" level="H4" class="sapUiSmallMarginBottom"/>

                <!-- Control Account mode -->
                <VBox visible="{= ${ps>/mode} === 'ca' }">
                  <CheckBox text="Control Account" selected="{ps>/selNode/ca/flag}" select=".onToggleCA" enabled="{ps>/d/hasSel}"/>
                  <MessageStrip type="Warning" showIcon="true" class="sapUiTinyMarginTopBottom"
                                visible="{= !!${ps>/d/caBlock} }" text="{= 'Not allowed — ' + ${ps>/d/caBlock} }"/>
                  <CheckBox text="Summary Level Planning Package (SLPP)" selected="{ps>/selNode/ca/slpp}" enabled="{ps>/d/caFlag}" select=".onTypeChange"/>
                  <HBox alignItems="Center" wrap="Wrap" visible="{= ${ps>/d/wpBelow} > 0 }" class="sapUiSmallMarginTop">
                    <Button icon="sap-icon://clear-all" type="Transparent" press=".onClearWPsBelow"
                            text="{= 'Clear ' + ${ps>/d/wpBelow} + ' work-package flag' + (${ps>/d/wpBelow} === 1 ? '' : 's') + ' below' }"/>
                    <Text text="Work packages exist below this element — clear them to unmark the control account or re-level the structure." class="sapUiTinyMarginBegin"/>
                  </HBox>
                  <VBox visible="{ps>/d/caFlag}" class="sapUiSmallMarginTop">
                    <Label text="Control Account Manager"/>
                    <Select selectedKey="{ps>/selNode/ca/cam}" items="{ps>/opts/cams}" width="18rem" forceSelection="false"><core:Item key="{ps>}" text="{ps>}"/></Select>
                    <Label text="Analyst" class="sapUiTinyMarginTop"/>
                    <Select selectedKey="{ps>/selNode/ca/analyst}" items="{ps>/opts/analysts}" width="18rem" forceSelection="false"><core:Item key="{ps>}" text="{ps>}"/></Select>
                    <Label text="Target Value (Project Currency)" class="sapUiTinyMarginTop"/>
                    <Input value="{ps>/selNode/ca/target}" type="Number" width="18rem"/>
                    <Label text="Scope of Work (SOW)" class="sapUiTinyMarginTop"/>
                    <TextArea value="{ps>/selNode/ca/sow}" rows="2" width="100%" growing="true"/>
                    <Label text="Authorization Information" class="sapUiTinyMarginTop"/>
                    <TextArea value="{ps>/selNode/ca/auth}" rows="2" width="100%" growing="true"/>
                    <Label text="General Notes" class="sapUiTinyMarginTop"/>
                    <TextArea value="{ps>/selNode/ca/notes}" rows="2" width="100%" growing="true"/>
                  </VBox>
                </VBox>

                <!-- Work Package mode -->
                <VBox visible="{= ${ps>/mode} === 'wp' }">
                  <CheckBox text="Work Package" selected="{ps>/selNode/wp/flag}" select=".onToggleWP" enabled="{ps>/d/hasSel}"/>
                  <MessageStrip type="Warning" showIcon="true" class="sapUiTinyMarginTopBottom"
                                visible="{= !!${ps>/d/wpBlock} }" text="{= 'Not allowed — ' + ${ps>/d/wpBlock} }"/>
                  <CheckBox text="Planning Package (PP)" selected="{ps>/selNode/wp/pp}" enabled="{ps>/d/wpFlag}" select=".onTypeChange"/>
                  <CheckBox text="Manufacturing Work Package" selected="{ps>/selNode/wp/mfg}" enabled="{ps>/d/wpFlag}" select=".onTypeChange"/>
                  <VBox visible="{ps>/d/wpFlag}" class="sapUiSmallMarginTop">
                    <Label text="Default EV Method"/>
                    <Select selectedKey="{ps>/selNode/wp/ev}" items="{ps>/opts/ev}" width="18rem" forceSelection="false"><core:Item key="{ps>}" text="{ps>}"/></Select>
                    <Label text="WP Manager" class="sapUiTinyMarginTop"/>
                    <Select selectedKey="{ps>/selNode/wp/mgr}" items="{ps>/opts/cams}" width="18rem" forceSelection="false"><core:Item key="{ps>}" text="{ps>}"/></Select>
                    <Label text="Cost Type (EOC)" class="sapUiTinyMarginTop"/>
                    <Select selectedKey="{ps>/selNode/wp/eoc}" items="{ps>/opts/eoc}" width="18rem" forceSelection="false"><core:Item key="{ps>}" text="{ps>}"/></Select>
                    <Label text="Recurring / Non-Recurring" class="sapUiTinyMarginTop"/>
                    <Select selectedKey="{ps>/selNode/wp/rec}" items="{ps>/opts/rec}" width="18rem"><core:Item key="{ps>}" text="{ps>}"/></Select>
                    <Label text="IMS Start Date" class="sapUiTinyMarginTop"/>
                    <Input value="{ps>/selNode/wp/imsS}" placeholder="MM/DD/YYYY" width="12rem"/>
                    <Label text="IMS Finish Date" class="sapUiTinyMarginTop"/>
                    <Input value="{ps>/selNode/wp/imsF}" placeholder="MM/DD/YYYY" width="12rem"/>
                    <Label text="Scope of Work (SOW)" class="sapUiTinyMarginTop"/>
                    <TextArea value="{ps>/selNode/wp/sow}" rows="2" width="100%" growing="true"/>
                    <Label text="Authorization Information" class="sapUiTinyMarginTop"/>
                    <TextArea value="{ps>/selNode/wp/auth}" rows="2" width="100%" growing="true"/>
                  </VBox>
                </VBox>

                <!-- MR / UB mode -->
                <VBox visible="{= ${ps>/mode} === 'mrub' }">
                  <CheckBox text="Management Reserve" selected="{ps>/selNode/mrub/mr}" select=".onToggleMR" enabled="{ps>/d/mrEnabled}"/>
                  <CheckBox text="Undistributed Budget" selected="{ps>/selNode/mrub/ub}" select=".onToggleUB" enabled="{ps>/d/ubEnabled}"/>
                  <MessageStrip type="Warning" showIcon="true" class="sapUiTinyMarginTopBottom"
                                visible="{= !!${ps>/d/mrubBlock} &amp;&amp; !${ps>/d/mrubFlag} }" text="{= 'Not allowed — ' + ${ps>/d/mrubBlock} }"/>
                  <VBox visible="{ps>/d/mrubFlag}" class="sapUiSmallMarginTop">
                    <Label text="Account Manager"/>
                    <Select selectedKey="{ps>/selNode/mrub/mgr}" items="{ps>/opts/cams}" width="18rem" forceSelection="false"><core:Item key="{ps>}" text="{ps>}"/></Select>
                    <Label text="Vendor" class="sapUiTinyMarginTop"/>
                    <Input value="{ps>/selNode/mrub/vendor}" width="18rem"/>
                  </VBox>
                </VBox>
              </VBox>
            </HBox>
          </VBox>
        </Panel>

      </VBox>
    </content>
  </Page>
</mvc:View>
