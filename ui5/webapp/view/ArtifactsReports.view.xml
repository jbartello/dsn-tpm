<mvc:View
  controllerName="dassian.tpm.ui5.controller.ArtifactsReports"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  xmlns:table="sap.ui.table"
  displayBlock="true">
  <Page id="artReportsPage" title="Project Artifacts &amp; Reports"
        class="sapUiResponsiveContentPadding">
    <content>
      <VBox class="sapUiMediumMargin">
        <Text text="Program document catalog. Select an artifact to open its report; WBS Dictionary, RAM, CAP, Tripwire and Control Log open an embedded data grid, the schedule and VAR artifacts open their module." class="sapUiSmallMarginBottom"/>
        <Table items="{/Artifacts}" growing="true" growingThreshold="20">
          <headerToolbar><OverflowToolbar><Title text="Artifacts &amp; Reports"/></OverflowToolbar></headerToolbar>
          <columns>
            <Column><Text text="Artifact"/></Column>
            <Column><Text text="Category"/></Column>
            <Column><Text text="Owner"/></Column>
            <Column><Text text="Last Updated"/></Column>
            <Column><Text text="Status"/></Column>
            <Column hAlign="End"><Text text=""/></Column>
          </columns>
          <items>
            <ColumnListItem type="Navigation" press=".onOpenArtifact">
              <cells>
                <Text text="{Name}"/>
                <Text text="{Category}"/>
                <Text text="{Owner}"/>
                <Text text="{LastUpdated}"/>
                <ObjectStatus text="{Status}" state="{= ${Status} === 'Current' ? 'Success' : 'Warning' }"/>
                <Button text="Open" type="Transparent" icon="sap-icon://display" press=".onOpenArtifact"/>
              </cells>
            </ColumnListItem>
          </items>
        </Table>
      </VBox>

      <Dialog id="reportDialog" title="Report" contentWidth="92%" contentHeight="82%" stretch="{device>/system/phone}" resizable="true">
        <content>
          <table:Table id="reportGrid" selectionMode="None" visibleRowCountMode="Auto" minAutoRowCount="12" enableColumnReordering="true"/>
          <VBox id="ramBox" height="100%" visible="false">
            <OverflowToolbar>
              <Label text="Month End"/>
              <Select id="ramPeriodSelect" selectedKey="{ram>/period}" items="{ram>/periods}" change=".onRamPeriodChange" autoAdjustWidth="true">
                <core:Item key="{ram>key}" text="{ram>text}"/>
              </Select>
              <ToolbarSpacer/>
              <Text text="Budgets shown through the selected month-end (illustrative; May = full)."/>
              <Button text="Export to Excel" icon="sap-icon://excel-attachment" press=".onRamExcel"/>
              <Button text="Export to PDF" icon="sap-icon://pdf-attachment" press=".onRamPdf"/>
            </OverflowToolbar>
            <ScrollContainer id="reportHtmlScroll" height="100%" width="100%" horizontal="true" vertical="true">
              <core:HTML id="reportHtml"/>
            </ScrollContainer>
          </VBox>
          <VBox id="capBox" height="100%" visible="false">
            <OverflowToolbar>
              <SegmentedButton selectedKey="{capui>/view}" selectionChange=".onCapViewChange">
                <items>
                  <SegmentedButtonItem key="tp" text="Time-Phased"/>
                  <SegmentedButtonItem key="summary" text="Summary"/>
                </items>
              </SegmentedButton>
              <ToolbarSpacer/>
              <Button text="Export to Excel" icon="sap-icon://excel-attachment" press=".onCapExcel"/>
              <Button text="Export to PDF" icon="sap-icon://pdf-attachment" press=".onCapPdf"/>
            </OverflowToolbar>
            <ScrollContainer id="capScroll" height="100%" width="100%" horizontal="true" vertical="true">
              <core:HTML id="capHtml"/>
            </ScrollContainer>
          </VBox>
          <VBox id="genBox" height="100%" visible="false">
            <OverflowToolbar id="genToolbar" visible="false">
              <ToolbarSpacer/>
              <Button id="wbsExcelBtn" text="Export to Excel" icon="sap-icon://excel-attachment" press=".onGenExcel"/>
              <Button id="wbsPdfBtn" text="Export to PDF" icon="sap-icon://pdf-attachment" press=".onGenPdf"/>
            </OverflowToolbar>
            <ScrollContainer id="genScroll" height="100%" width="100%" horizontal="true" vertical="true">
              <core:HTML id="genHtml"/>
            </ScrollContainer>
          </VBox>
        </content>
        <beginButton><Button text="Close" press=".onCloseReport"/></beginButton>
      </Dialog>
    </content>
  </Page>
</mvc:View>
