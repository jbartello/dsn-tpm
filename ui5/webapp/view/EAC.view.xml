<mvc:View
  controllerName="dassian.tpm.ui5.controller.EAC"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  displayBlock="true">
  <Page id="eacPage" title="Project EAC — Estimate at Completion" showNavButton="true" navButtonPress=".onNavBack"
        class="sapUiResponsiveContentPadding">
    <subHeader>
      <OverflowToolbar>
        <Label text="Program"/>
        <Select selectedKey="{ui>/program}" change=".onProgramChange">
          <core:Item key="DEMO" text="Demo"/>
          <core:Item key="MFG" text="MFG Program"/>
        </Select>
      </OverflowToolbar>
    </subHeader>
    <content>
      <VBox class="sapUiMediumMargin">
        <Title text="Estimate at Completion — Demo program" level="H2" class="sapUiSmallMarginBottom"/>
        <HBox wrap="Wrap" class="sapUiSmallMarginBottom">
          <VBox class="mcStatBox"><Text text="Total BAC" class="mcStatLbl"/><Title text="{eac>/totals/bacT}" level="H4"/></VBox>
          <VBox class="mcStatBox"><Text text="ACWP to date" class="mcStatLbl"/><Title text="{eac>/totals/acwpT}" level="H4"/></VBox>
          <VBox class="mcStatBox"><Text text="ETC" class="mcStatLbl"/><Title text="{eac>/totals/etcT}" level="H4"/></VBox>
          <VBox class="mcStatBox"><Text text="Contract EAC" class="mcStatLbl"/><Title text="{eac>/totals/eacT}" level="H4"/></VBox>
          <VBox class="mcStatBox"><Text text="VAC" class="mcStatLbl"/><Title text="{eac>/totals/vacT}" level="H4"/></VBox>
          <VBox class="mcStatBox"><Text text="Program CPI" class="mcStatLbl"/><Title text="{eac>/totals/progCpiT}" level="H4"/></VBox>
          <VBox class="mcStatBox"><Text text="IEAC (BAC/CPI)" class="mcStatLbl"/><Title text="{eac>/totals/progIeacT}" level="H4"/></VBox>
        </HBox>

        <Table items="{eac>/items}" class="sapUiMediumMarginTop">
          <headerToolbar><OverflowToolbar><Title text="Control Account EAC analysis"/></OverflowToolbar></headerToolbar>
          <columns>
            <Column><Text text="WBS / CA"/></Column>
            <Column><Text text="Description"/></Column>
            <Column hAlign="End"><Text text="BAC"/></Column>
            <Column hAlign="End"><Text text="ACWP"/></Column>
            <Column hAlign="End"><Text text="ETC"/></Column>
            <Column hAlign="End"><Text text="Contract EAC"/></Column>
            <Column hAlign="End"><Text text="IEAC (CPI)"/></Column>
            <Column hAlign="End"><Text text="IEAC (CPI×SPI)"/></Column>
            <Column hAlign="End"><Text text="VAC"/></Column>
          </columns>
          <items>
            <ColumnListItem>
              <cells>
                <Text text="{eac>wbs}"/>
                <Text text="{eac>desc}"/>
                <Text text="{eac>bacT}"/>
                <Text text="{eac>acwpT}"/>
                <Text text="{eac>etcT}"/>
                <Text text="{eac>eacT}"/>
                <Text text="{eac>ieacCpiT}"/>
                <Text text="{eac>ieacCompT}"/>
                <ObjectNumber number="{eac>vacT}" state="{= ${eac>vac} &lt; 0 ? 'Error' : 'Success' }"/>
              </cells>
            </ColumnListItem>
          </items>
        </Table>
        <Text text="EAC = ACWP + ETC (actuals-to-date plus estimate-to-complete).  IEAC (CPI) = BAC ÷ CPI.  IEAC (CPI×SPI) = ACWP + (BAC − BCWP) ÷ (CPI × SPI).  Illustrative; not-started accounts show —." class="sapUiSmallMarginTop"/>
      </VBox>
    </content>
  </Page>
</mvc:View>
