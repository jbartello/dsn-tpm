<mvc:View
  controllerName="dassian.tpm.ui5.controller.Analytics"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  displayBlock="true">
  <Page id="analyticsPage" title="Project Analytics — EVM" showNavButton="true" navButtonPress=".onNavBack"
        class="sapUiResponsiveContentPadding">
    <subHeader>
      <OverflowToolbar>
        <Label text="Program"/>
        <Select selectedKey="{ui>/program}" change=".onProgramChange">
          <core:Item key="DEMO" text="Demo"/>
          <core:Item key="MFG" text="MFG Program"/>
        </Select>
        <ToolbarSpacer/>
        <Label text="Status period"/>
        <Select selectedKey="{flt>/period}" change=".onPeriodChange"
                items="{flt>/periods}">
          <core:Item key="{flt>id}" text="{flt>label}"/>
        </Select>
      </OverflowToolbar>
    </subHeader>
    <content>
      <VBox class="sapUiMediumMargin">
        <Text text="Earned-value performance across the program. Simulated EVM time-phasing; all charts respond to the program and status period above." class="sapUiSmallMarginBottom"/>
        <core:HTML id="chartsHtml"/>
      </VBox>
    </content>
  </Page>
</mvc:View>
