{
  "_version": "1.59.0",
  "sap.app": {
    "id": "dassian.tpm.ui5",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": { "version": "0.1.0" },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "crossNavigation": {
      "inbounds": {
        "tpm-display": {
          "semanticObject": "tpm",
          "action": "display",
          "title": "{{appTitle}}",
          "signature": { "parameters": {}, "additionalParameters": "allowed" }
        }
      }
    },
    "dataSources": {
      "mainService": {
        "uri": "/odata/mainService/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0",
          "localUri": "localService/mainService/metadata.xml",
          "annotations": ["localAnnotations"]
        }
      },
      "localAnnotations": {
        "type": "ODataAnnotation",
        "uri": "annotations/annotations.xml",
        "settings": { "localUri": "annotations/annotations.xml" }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": { "desktop": true, "tablet": true, "phone": true }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {},
        "sap.fe.core": {},
        "sap.ui.layout": {},
        "sap.viz": {}
      }
    },
    "contentDensities": { "compact": true, "cozy": true },
    "resources": {
      "css": [ { "uri": "css/style.css" } ]
    },
    "rootView": {
      "viewName": "sap.fe.core.rootView.NavContainer",
      "type": "XML",
      "id": "appRootView",
      "async": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": { "bundleName": "dassian.tpm.ui5.i18n.i18n" }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "synchronizationMode": "None",
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      }
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "controlAggregation": "pages",
        "controlId": "appContent",
        "transition": "slide",
        "async": true,
        "viewType": "XML"
      },
      "routes": [
        {
          "pattern": ":?query:",
          "name": "Home",
          "target": "TargetHome"
        },
        {
          "pattern": "ControlAccounts:?query:",
          "name": "ControlAccountsList",
          "target": "ControlAccountsList"
        },
        {
          "pattern": "ControlAccounts({key}):?query:",
          "name": "ControlAccountsObjectPage",
          "target": "ControlAccountsObjectPage"
        },
        {
          "pattern": "Risks:?query:",
          "name": "RisksList",
          "target": "RisksList"
        },
        {
          "pattern": "Risks({key}):?query:",
          "name": "RisksObjectPage",
          "target": "RisksObjectPage"
        },
        {
          "pattern": "Analytics",
          "name": "Analytics",
          "target": "TargetAnalytics"
        },
        {
          "pattern": "RiskMatrix",
          "name": "RiskMatrix",
          "target": "TargetRiskMatrix"
        },
        {
          "pattern": "MasterSchedule",
          "name": "MasterSchedule",
          "target": "TargetMasterSchedule"
        },
        {
          "pattern": "VAR",
          "name": "VAR",
          "target": "TargetVAR"
        },
        {
          "pattern": "Projects:?query:",
          "name": "ProjectsList",
          "target": "ProjectsList"
        },
        {
          "pattern": "Projects({key}):?query:",
          "name": "ProjectsObjectPage",
          "target": "ProjectsObjectPage"
        },
        {
          "pattern": "EAC",
          "name": "EAC",
          "target": "TargetEAC"
        }
      ],
      "targets": {
        "TargetHome": {
          "type": "View",
          "id": "Home",
          "name": "dassian.tpm.ui5.view.Home",
          "viewType": "XML",
          "controlAggregation": "pages"
        },
        "TargetAnalytics": {
          "type": "View",
          "id": "Analytics",
          "name": "dassian.tpm.ui5.view.Analytics",
          "viewType": "XML",
          "controlAggregation": "pages"
        },
        "TargetRiskMatrix": {
          "type": "View",
          "id": "RiskMatrix",
          "name": "dassian.tpm.ui5.view.RiskMatrix",
          "viewType": "XML",
          "controlAggregation": "pages"
        },
        "TargetMasterSchedule": {
          "type": "View",
          "id": "MasterSchedule",
          "name": "dassian.tpm.ui5.view.MasterSchedule",
          "viewType": "XML",
          "controlAggregation": "pages"
        },
        "TargetVAR": {
          "type": "View",
          "id": "VAR",
          "name": "dassian.tpm.ui5.view.VAR",
          "viewType": "XML",
          "controlAggregation": "pages"
        },
        "ProjectsList": {
          "type": "Component",
          "id": "ProjectsList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/Projects",
              "variantManagement": "Page",
              "initialLoad": "Enabled",
              "navigation": { "Projects": { "detail": { "route": "ProjectsObjectPage" } } }
            }
          }
        },
        "ProjectsObjectPage": {
          "type": "Component",
          "id": "ProjectsObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": { "settings": { "contextPath": "/Projects" } }
        },
        "TargetEAC": {
          "type": "View",
          "id": "EAC",
          "name": "dassian.tpm.ui5.view.EAC",
          "viewType": "XML",
          "controlAggregation": "pages"
        },
        "RisksList": {
          "type": "Component",
          "id": "RisksList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/Risks",
              "variantManagement": "Page",
              "initialLoad": "Enabled",
              "navigation": {
                "Risks": { "detail": { "route": "RisksObjectPage" } }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": { "type": "ResponsiveTable" }
                }
              }
            }
          }
        },
        "RisksObjectPage": {
          "type": "Component",
          "id": "RisksObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": { "settings": { "contextPath": "/Risks" } }
        },
        "ControlAccountsList": {
          "type": "Component",
          "id": "ControlAccountsList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/ControlAccounts",
              "variantManagement": "Page",
              "initialLoad": "Enabled",
              "navigation": {
                "ControlAccounts": {
                  "detail": { "route": "ControlAccountsObjectPage" }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": { "type": "ResponsiveTable" }
                }
              }
            }
          }
        },
        "ControlAccountsObjectPage": {
          "type": "Component",
          "id": "ControlAccountsObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "contextPath": "/ControlAccounts"
            }
          }
        }
      }
    }
  }
}
